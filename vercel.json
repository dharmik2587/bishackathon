{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "env": {
    "VITE_API_URL": {
      "description": "Backend API URL for the frontend",
      "required": false,
      "default": "https://bis-rag-backend.onrender.com"
    }
  },
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "https://bis-rag-backend.onrender.com/api/:path*"
    }
  ]
}
